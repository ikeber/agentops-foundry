# Copy to .env and fill in your own values. .env is git-ignored.
# These are identifiers, not secrets. Foundry authenticates with Microsoft Entra ID only:
# run `az login` locally, or set the standard AZURE_* variables for a service principal or
# workload identity in CI. Never put credentials in this file or in source control.

# Foundry project endpoint, from the project's overview page in the Foundry portal.
FOUNDRY_PROJECT_ENDPOINT=https://<resource-name>.services.ai.azure.com/api/projects/<project-name>

# Name of the Foundry agent under test.
FOUNDRY_AGENT_NAME=<agent-name>
